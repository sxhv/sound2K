{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions for the main window only. No filesystem, shell, HTTP or opener plugins. Window permissions cover only the custom title bar (drag, minimize, maximize, close). The SoundCloud sign-in window is not listed, so it cannot call any command.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-get-account",
    "allow-start-login",
    "allow-logout",
    "allow-get-liked-tracks",
    "allow-get-playlists",
    "allow-get-playlist-tracks",
    "allow-load-settings",
    "allow-save-settings",
    "allow-player-load",
    "allow-player-pause",
    "allow-player-resume",
    "allow-player-seek",
    "allow-player-set-volume",
    "allow-player-stop",
    "allow-player-status",
    "allow-load-history",
    "allow-save-history",
    "allow-media-update",
    "allow-set-window-mode",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "allow-player-preload",
    "allow-player-set-dsp",
    "allow-player-spectrum",
    "allow-like-track",
    "allow-get-related-tracks",
    "allow-open-on-soundcloud",
    "allow-load-session",
    "allow-save-session",
    "allow-storage-info",
    "allow-clear-cache",
    "allow-artwork-colour",
    "allow-create-playlist",
    "allow-rename-playlist",
    "allow-edit-playlist-track",
    "allow-delete-playlist",
    "allow-move-playlist-track",
    "allow-download-track",
    "allow-discord-presence",
    "allow-discord-available",
    "allow-discord-status-text",
    "allow-search-tracks",
    "allow-search-artists",
    "allow-search-playlists",
    "allow-get-artist",
    "allow-get-artist-tracks",
    "allow-get-artist-playlists",
    "allow-get-feed",
    "allow-follow-artist",
    "allow-get-followings",
    "allow-check-for-update",
    "allow-open-update-page",
    "allow-install-update"
  ]
}
